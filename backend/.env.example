# ClearBill AI backend settings.
# Copy to backend/.env and fill in locally. Never commit real values.
# Load with: uvicorn app.main:app --env-file .env

# Google AI Studio key for the Gemini API. Leave blank to run demo-only.
GEMINI_API_KEY=
# A Gemini model verified to accept PDF/image input AND structured JSON output.
# Configured server-side only; never hardcode it in prompts or the frontend.
GEMINI_MODEL=
# Per-attempt timeout for one Gemini extraction call (up to 2 retries on transient errors).
GEMINI_TIMEOUT_SECONDS=90

FRONTEND_ORIGIN=http://localhost:3000
DEMO_MODE=true

# Upload limits (per file). Keep in sync with api_contract.yaml.
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=6
