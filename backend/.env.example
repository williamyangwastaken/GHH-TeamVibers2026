# Sana backend settings.
# Copy to backend/.env and fill in locally. Never commit real values.
# Load with: uvicorn app.main:app --env-file .env

# GroqCloud keys. Keep these server-side; never place them in the frontend.
# All keys are pooled, deduplicated, and used round-robin; a 429/5xx on one key
# fails over to the next immediately. Alternatively set GROQ_API_KEYS=key1,key2.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=qwen/qwen3.8-27b
# Per-request timeout in seconds. No sleeping retries: failures rotate keys.
GROQ_TIMEOUT_SECONDS=25

FRONTEND_ORIGIN=http://localhost:3000
DEMO_MODE=true

# Upload limits (per file). Keep in sync with api_contract.yaml.
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=6
