# ClearBill AI backend settings.
# Copy to backend/.env and fill in locally. Never commit real values.
# Load with: uvicorn app.main:app --env-file .env

# GroqCloud key. Keep this server-side; never place it in the frontend.
GROQ_API_KEY=
# Vision-capable Groq model used for image inputs and scanned PDF pages.
GROQ_MODEL=qwen/qwen3.8-27b
# Per-attempt timeout (up to 2 retries on transient errors).
GROQ_TIMEOUT_SECONDS=90

FRONTEND_ORIGIN=http://localhost:3000
DEMO_MODE=true

# Upload limits (per file). Keep in sync with api_contract.yaml.
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=6
